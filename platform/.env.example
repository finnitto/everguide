APP_ENV=development
APP_NAME=Everguide
APP_VERSION=2.8.0
POSTGRES_DB=everguide
POSTGRES_USER=everguide
POSTGRES_PASSWORD=change-this-local-password
DB_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://everguide:change-this-local-password@db:5432/everguide
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Independent web search for automatic provider website discovery
BRAVE_SEARCH_API_KEY=

# Search adapter: brave (Google adapter not implemented)
SEARCH_PROVIDER=brave

# Companies House Public Data API (free API key)
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_SIC_CODES=96030

# Automation-first provider publication (high-confidence first-party website evidence only)
AUTO_APPROVE_PROVIDERS=false
AUTO_APPROVAL_MIN_CONFIDENCE=0.94


# Automatically enrich and assess Overture records after discovery
OVERTURE_AUTO_PROCESS=true

# Scheduled England-wide Overture STAC / Places GeoParquet feed
OVERTURE_FEED_ENABLED=false
# Scheduled tasks and automatic post-import processing remain disabled during validation. Manual API actions require reviewer authentication.
OVERTURE_SCHEDULED_TASKS_ENABLED=false
OVERTURE_FEED_DAILY_HOUR=4
OVERTURE_FEED_DAILY_MINUTE=30
OVERTURE_FEED_BATCH_SIZE=500

# Deterministic price extraction from verified provider-owned websites.
PRICE_ENRICHMENT_ENABLED=true
PRICE_ENRICHMENT_MAX_PAGES=6

# Safe redirects followed while checking Overture-supplied websites (0 to 5).
WEBSITE_MAX_REDIRECTS=3

# Identity-review API authentication: JSON mapping reviewer IDs to SHA-256 token hashes.
# Generate a high-entropy token privately, hash it with SHA-256, and store only the hash here.
# Example shape (replace with a real reviewer ID and 64-character hash):
IDENTITY_REVIEW_CREDENTIALS={}

# Persistent, validated ONS boundary cache (worker named volume)
ONS_BOUNDARY_CACHE_TTL_HOURS=720
