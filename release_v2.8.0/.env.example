APP_ENV=development
APP_NAME=Everguide
APP_VERSION=2.8.0-rc.1
POSTGRES_DB=everguide
POSTGRES_USER=everguide
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://everguide:change-this-local-password@db:5432/everguide
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Independent web search for automatic provider website discovery
BRAVE_SEARCH_API_KEY=

# Search adapter: brave (Google adapter not implemented)
SEARCH_PROVIDER=brave

# Companies House Public Data API (free API key)
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_SIC_CODES=96030

# Automation-first provider publication (high-confidence first-party website evidence only)
AUTO_APPROVE_PROVIDERS=false
AUTO_APPROVAL_MIN_CONFIDENCE=0.94


# Automatically enrich and assess Overture records after discovery
OVERTURE_AUTO_PROCESS=true

# Scheduled Overture STAC / Places GeoParquet feed (geographically scoped below)
OVERTURE_FEED_ENABLED=true
# Scheduled tasks remain disabled during end-to-end validation. Manual API actions remain available.
OVERTURE_SCHEDULED_TASKS_ENABLED=false
OVERTURE_FEED_DAILY_HOUR=4
OVERTURE_FEED_DAILY_MINUTE=30
OVERTURE_FEED_BATCH_SIZE=500

# Geographic rollout: local_authorities or england. Keep the initial pilot local.
GEOGRAPHY_MODE=local_authorities
GEOGRAPHY_AUTHORITIES=thurrock

# Persistent, validated ONS boundary cache (worker named volume)
ONS_BOUNDARY_CACHE_TTL_HOURS=720
